<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widgetBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI ML ROADMAP"
            android:textColor="#E0E0E0"
            android:textStyle="bold"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"/>

        <ImageView
            android:id="@+id/widgetProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Roadmap completion"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widgetDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="DAY 1 / 130"
        android:textColor="#B0B0B0"
        android:textSize="8sp"
        android:textStyle="bold"
        android:singleLine="true"/>

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Today's Target"
        android:textColor="#E0E0E0"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/widgetDsa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#B0B0B0"
        android:textSize="8sp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetPrev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="‹"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:background="@drawable/button_bg"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/widgetDone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="✓ DONE"
            android:textSize="9sp"
            android:textColor="#121212"
            android:background="@drawable/button_primary_bg"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/widgetNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="›"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:background="@drawable/button_bg"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
